<Window x:Class="ZeyhDramTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZeyhDramTweaker.Core.Localization;assembly=ZeyhDramTweaker.Core"
        xmlns:vm="clr-namespace:ZeyhDramTweaker.ViewModels"
        Title="Zeyh DRAM Tweaker" Width="1380" Height="900" MinWidth="1120" MinHeight="680"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        WindowStartupLocation="CenterScreen" Icon="Assets/logo.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="8" UseAeroCaptionButtons="True" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <vm:NullToCollapsed x:Key="NullCollapsed"/>
        <vm:InverseBoolToVisibility x:Key="NotVis"/>
        <vm:InverseBool x:Key="Not"/>

        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource Num}">
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HeadCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- table row: columns shared inside the table so values line up -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:RowViewModel}">
            <Border x:Name="row" Background="Transparent" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="10,0" MinHeight="30" CornerRadius="4">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="N" MinWidth="118"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="V0"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="V1"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="V2"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="V3"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="NS"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="C"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="D"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                                ToolTip="{Binding Hint}" ToolTipService.IsEnabled="{Binding Hint, Converter={StaticResource NullCollapsed}, ConverterParameter=bool}">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text2Brush}" FontSize="13"/>
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="6,2,0,0"
                                   Foreground="{StaticResource AccentBrush}" Visibility="{Binding Hint, Converter={StaticResource NullCollapsed}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding V0}" Style="{StaticResource Cell}"/>
                    <TextBlock Grid.Column="2" Text="{Binding V1}" Style="{StaticResource Cell}" Visibility="{Binding V1, Converter={StaticResource NullCollapsed}}"/>
                    <TextBlock Grid.Column="3" Text="{Binding V2}" Style="{StaticResource Cell}" Visibility="{Binding V2, Converter={StaticResource NullCollapsed}}"/>
                    <TextBlock Grid.Column="4" Text="{Binding V3}" Style="{StaticResource Cell}" Visibility="{Binding V3, Converter={StaticResource NullCollapsed}}"/>
                    <TextBlock Grid.Column="5" Text="{Binding Ns}" Style="{StaticResource Cell}" Foreground="{StaticResource MutedBrush}" Visibility="{Binding Ns, Converter={StaticResource NullCollapsed}}"/>
                    <TextBlock Grid.Column="6" Text="{Binding Current}" Style="{StaticResource Cell}" Visibility="{Binding Current, Converter={StaticResource NullCollapsed}}"/>
                    <TextBlock Grid.Column="7" Text="{Binding DiffGlyph}" Foreground="{Binding DiffBrush}" FontSize="10" Margin="8,0,0,0" MinWidth="10"
                               VerticalAlignment="Center" ToolTip="{Binding DiffTip}" Visibility="{Binding Current, Converter={StaticResource NullCollapsed}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TableTemplate" DataType="{x:Type vm:SectionViewModel}">
            <StackPanel Margin="0,0,28,26" Grid.IsSharedSizeScope="True" MinWidth="250">
                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="14" Margin="10,0,0,2"/>
                <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" Margin="10,0,0,10"/>
                <Border Background="{StaticResource HeaderBandBrush}" CornerRadius="4" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="N" MinWidth="118"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="V0"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="V1"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="V2"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="V3"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="NS"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="C"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="D"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FirstHeader}" Style="{StaticResource HeadCell}" TextAlignment="Left" Margin="0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Headers[0]}" Style="{StaticResource HeadCell}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Headers[1]}" Style="{StaticResource HeadCell}" Visibility="{Binding Headers[1], Converter={StaticResource NullCollapsed}}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Headers[2]}" Style="{StaticResource HeadCell}" Visibility="{Binding Headers[2], Converter={StaticResource NullCollapsed}}"/>
                        <TextBlock Grid.Column="4" Text="{Binding Headers[3]}" Style="{StaticResource HeadCell}" Visibility="{Binding Headers[3], Converter={StaticResource NullCollapsed}}"/>
                        <TextBlock Grid.Column="5" Text="{Binding Headers[4]}" Style="{StaticResource HeadCell}" Visibility="{Binding Headers[4], Converter={StaticResource NullCollapsed}}"/>
                        <TextBlock Grid.Column="6" Text="{Binding Headers[5]}" Style="{StaticResource HeadCell}" Visibility="{Binding Headers[5], Converter={StaticResource NullCollapsed}}"/>
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NoticeTemplate" DataType="{x:Type vm:NoticeViewModel}">
            <Border Background="{Binding Tint}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" Foreground="{Binding Brush}" FontSize="15" Margin="0,2,0,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" FontSize="13"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TabBody" DataType="{x:Type vm:TabViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,18,8,0" Focusable="False">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource TableTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource NoticeTemplate}" Margin="0,0,16,20" Focusable="False" MaxWidth="980" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- page header -->
        <Style x:Key="PageHeader" TargetType="StackPanel">
            <Setter Property="Margin" Value="36,26,36,18"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsShort, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="36,14,36,12"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsShort, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SafeCommand}"/>
        <KeyBinding Key="F6" Command="{Binding FastCommand}"/>
        <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding CopyCommand}"/>
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- title bar (on Mica; the system draws min/max/close) -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
            <Image Source="Assets/logo.png" Width="18" Height="18" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Zeyh DRAM Tweaker" FontSize="12.5" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- navigation rail -->
        <ListBox Grid.Row="1" Style="{StaticResource NavRail}" ItemsSource="{Binding Nav}" SelectedIndex="{Binding SelectedPage}" Margin="2,4,2,0"
                 AutomationProperties.Name="Navegação">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NavItem}">
                    <StackPanel>
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="19" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- content layer -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource LayerBrush}" BorderBrush="{StaticResource LayerStrokeBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>
                <!-- ======================= page: calculator ======================= -->
                <Grid Visibility="{Binding IsCalcPage, Converter={StaticResource Vis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Style="{StaticResource PageHeader}">
                        <TextBlock Text="{Binding [page.calc.title], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{Binding [page.calc.sub], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource PageSub}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="36,0,28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*" MaxWidth="1200"/>
                        </Grid.ColumnDefinitions>

                        <!-- configuration card -->
                        <Border Style="{StaticResource Card}" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,0">
                                <StackPanel x:Name="ConfigPanel" Margin="0,18,0,20">
                                    <TextBlock Text="{Binding [card.config], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{Binding [ui.platform], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}" AutomationProperties.Name="{Binding [ui.platform], Source={x:Static loc:Loc.Instance}}"/>
                                    <StackPanel Visibility="{Binding IsDdr4, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding [ui.board], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding Topologies}" SelectedItem="{Binding SelectedTopology}" AutomationProperties.Name="{Binding [ui.board], Source={x:Static loc:Loc.Instance}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding [ui.ic], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Ics}" SelectedItem="{Binding SelectedIc}" AutomationProperties.Name="{Binding [ui.ic], Source={x:Static loc:Loc.Instance}}"/>
                                    <TextBlock Text="{Binding [ui.profile], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="{Binding [ui.profile], Source={x:Static loc:Loc.Instance}}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [ui.ranks], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}"/>
                                            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding RankOptions}" SelectedItem="{Binding SelectedRank}" AutomationProperties.Name="{Binding [ui.ranks], Source={x:Static loc:Loc.Instance}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding [ui.dimms], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}"/>
                                            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding DimmOptions}" SelectedItem="{Binding SelectedDimms}" AutomationProperties.Name="{Binding [ui.dimms], Source={x:Static loc:Loc.Instance}}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding [ui.frequency], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding SelectedMts}" AutomationProperties.Name="{Binding [ui.frequency], Source={x:Static loc:Loc.Instance}}"/>

                                    <StackPanel Visibility="{Binding IsManual, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding [ui.manualNs], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,16,0,8"/>
                                        <ItemsControl ItemsSource="{Binding NsFields}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:NsField}">
                                                    <StackPanel Margin="0,0,8,10">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" Margin="2,0,0,4"/>
                                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=300}" AutomationProperties.Name="{Binding Name}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Button Command="{Binding GoMemoryCommand}" Style="{StaticResource SecondaryButton}" Margin="0,22,0,0" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE964;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="0,1,10,0"/>
                                            <TextBlock Text="{Binding [mem.read.title], Source={x:Static loc:Loc.Instance}}"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text2Brush}" Margin="0,10,0,0" LineHeight="17"
                                               Visibility="{Binding Status, Converter={StaticResource NullCollapsed}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- results -->
                        <Grid Grid.Column="2" x:Name="ResultSheet" DataContext="{Binding Result}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- hero: the recommendation at a glance. Gauges sit beside the timings, or under them when the column is narrow -->
                            <Border x:Name="Hero" Style="{StaticResource Card}" Padding="24,20" Visibility="{Binding Ok, Converter={StaticResource Vis}}">
                                <Grid x:Name="HeroGrid">
                                    <!-- timings (up to 360) | gauges | the rest: the gauges read as part of the recommendation, not a separate block on the far right -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="360"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="0.001*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [hero.title], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Speed}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <ListBox Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Segmented}" Width="160" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0"
                                             ItemsSource="{Binding DataContext.Presets, RelativeSource={RelativeSource AncestorType=Window}}"
                                             SelectedItem="{Binding DataContext.SelectedPreset, RelativeSource={RelativeSource AncestorType=Window}}"
                                             AutomationProperties.Name="Preset" ToolTip="F5 SAFE / F6 FAST"/>

                                    <StackPanel Grid.Row="1">
                                        <TextBlock x:Name="HeroKit" Text="{Binding Kit}" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="SemiBold" Margin="0,6,0,0" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding Details}" Foreground="{StaticResource Text2Brush}" FontSize="13" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular" TextWrapping="Wrap" LineHeight="19"/>
                                    </StackPanel>

                                    <ItemsControl x:Name="HeroGauges" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Gauges}" Margin="24,16,0,0" Focusable="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:Gauge}">
                                                <Grid Margin="22,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="6" Height="46" CornerRadius="3" Background="#1FFFFFFF" VerticalAlignment="Top">
                                                        <Border Height="{Binding BarHeight}" CornerRadius="3" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,-3,0,0" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text2Brush}" FontSize="12"/>
                                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" Visibility="{Binding Sub, Converter={StaticResource NullCollapsed}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- actions wrap to a second line instead of being cut off on a narrow window -->
                                    <WrapPanel x:Name="HeroButtons" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,18,0,-8">
                                        <Button Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" ToolTip="Ctrl+Shift+C" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="0,1,8,0"/>
                                                <TextBlock Text="{Binding [hero.copy], Source={x:Static loc:Loc.Instance}}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.SavePngCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="0,1,8,0"/>
                                                <TextBlock Text="{Binding [hero.png], Source={x:Static loc:Loc.Instance}}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.GoTestCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="0,1,8,0"/>
                                                <TextBlock Text="{Binding [hero.test], Source={x:Static loc:Loc.Instance}}"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <!-- one compact bar for the warnings; the full list lives in the Notes tab -->
                            <Border Grid.Row="1" Margin="0,10,0,0" Background="{Binding TopAlert.Tint}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="14,6,6,6"
                                    Visibility="{Binding HasAlerts, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding DataContext.ShowNotesCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource QuietButton}"
                                            Padding="10,5" VerticalAlignment="Top" Margin="12,0,0,0" Content="{Binding [alert.seeall], Source={x:Static loc:Loc.Instance}}"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding TopAlert.Glyph}" FontFamily="{StaticResource Icons}" Foreground="{Binding TopAlert.Brush}" FontSize="15" Width="28" Margin="0,6,0,0"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding AlertCount}" FontWeight="SemiBold" FontSize="13" Margin="0,5,10,0" Visibility="{Binding ManyAlerts, Converter={StaticResource Vis}}"/>
                                    <Grid Margin="0,5,0,4">
                                        <TextBlock Text="{Binding TopAlert.Text}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding TopAlert.Text}" Visibility="{Binding ManyAlerts, Converter={StaticResource Vis}}"/>
                                        <TextBlock Text="{Binding TopAlert.Text}" FontSize="13" TextWrapping="Wrap" LineHeight="19" Visibility="{Binding ManyAlerts, Converter={StaticResource NotVis}}"/>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0,6,0,0" Margin="0,8,0,0" Visibility="{Binding Ok, Converter={StaticResource Vis}}">
                                <TabControl x:Name="Tabs" ItemsSource="{Binding Tabs}" DisplayMemberPath="Header" ContentTemplate="{StaticResource TabBody}"/>
                            </Border>

                            <!-- empty state: nothing to recommend yet, say why and what to do -->
                            <Border Grid.RowSpan="3" Style="{StaticResource Card}" Padding="28,26" VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top" Visibility="{Binding NeedsValues, Converter={StaticResource Vis}}">
                                        <TextBlock Text="&#xE964;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource WarnTintBrush}" VerticalAlignment="Top" Visibility="{Binding NeedsValues, Converter={StaticResource NotVis}}">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,2,0,0" MaxWidth="660" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource CardTitle}" FontSize="18" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding EmptyBody}" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" LineHeight="20" FontSize="13" Margin="0,8,0,0"
                                                   Visibility="{Binding EmptyBody, Converter={StaticResource NullCollapsed}}"/>
                                        <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"
                                                   Visibility="{Binding EmptyHint, Converter={StaticResource NullCollapsed}}"/>
                                        <WrapPanel Margin="0,18,0,0" Visibility="{Binding NeedsValues, Converter={StaticResource Vis}}">
                                            <Button Command="{Binding DataContext.ReadFromCalcCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="0,1,10,0"
                                                               Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotVis}}"/>
                                                    <TextBlock Text="&#xE964;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="0,1,10,0"
                                                               Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"/>
                                                    <TextBlock Text="{Binding [ui.readMem], Source={x:Static loc:Loc.Instance}}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding DataContext.ImportCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="0,1,8,0"/>
                                                    <TextBlock Text="{Binding [ui.importTp.link], Source={x:Static loc:Loc.Instance}}"/>
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <ItemsControl ItemsSource="{Binding EmptyExtras}" ItemTemplate="{StaticResource NoticeTemplate}" Margin="0,16,0,0" Focusable="False"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ======================= page: my memory ======================= -->
                <Grid Visibility="{Binding IsMemoryPage, Converter={StaticResource Vis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Style="{StaticResource PageHeader}">
                        <TextBlock Text="{Binding [page.memory.title], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{Binding [page.memory.sub], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource PageSub}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,0,28,24">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1480"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="24,22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE964;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,2,24,0">
                                        <TextBlock Text="{Binding [mem.read.title], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" FontSize="16"/>
                                        <TextBlock Text="{Binding [mem.read.body], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20" FontSize="13" MaxWidth="640" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,0" Visibility="{Binding Status, Converter={StaticResource NullCollapsed}}"/>
                                        <Button Command="{Binding ImportCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="-10,8,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,1,8,0"/>
                                                <TextBlock Text="{Binding [mem.thaiphoon], Source={x:Static loc:Loc.Instance}}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- first read: the main action; once read: a quieter "read again" with the time of the last read -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                        <Button Command="{Binding ReadPcCommand}" Style="{StaticResource PrimaryButton}" MinWidth="220" Padding="22,11"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" Visibility="{Binding HasRead, Converter={StaticResource NotVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="0,1,10,0" Visibility="{Binding IsAdmin, Converter={StaticResource NotVis}}"/>
                                                <TextBlock Text="&#xE964;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="0,1,10,0" Visibility="{Binding IsAdmin, Converter={StaticResource Vis}}"/>
                                                <TextBlock Text="{Binding [ui.readMem], Source={x:Static loc:Loc.Instance}}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ReadPcCommand}" Style="{StaticResource SecondaryButton}" MinWidth="180" Padding="18,9" HorizontalAlignment="Right"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" Visibility="{Binding HasRead, Converter={StaticResource Vis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="0,1,10,0" Visibility="{Binding IsAdmin, Converter={StaticResource NotVis}}"/>
                                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="0,1,10,0" Visibility="{Binding IsAdmin, Converter={StaticResource Vis}}"/>
                                                <TextBlock Text="{Binding [ui.readAgain], Source={x:Static loc:Loc.Instance}}"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{Binding LastReadText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,8,2,0"
                                                   Visibility="{Binding HasRead, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- sticks -->
                            <StackPanel Visibility="{Binding HasModules, Converter={StaticResource Vis}}" Margin="0,24,0,0">
                                <TextBlock Text="{Binding [mem.modules], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" Margin="2,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Modules}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ModuleViewModel}">
                                            <Border Style="{StaticResource Card}" Width="360" Margin="0,0,12,12" Padding="20,18">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Size}" Foreground="{StaticResource Text2Brush}" FontSize="13" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Chip}" Foreground="{StaticResource Text2Brush}" FontSize="13" Margin="0,1,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="10,3">
                                                            <TextBlock Text="{Binding IcName}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding [ui.ic.guess], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource WarnBrush}" FontSize="12" Margin="10,3,0,0"
                                                                   Visibility="{Binding IcUncertain, Converter={StaticResource Vis}}"/>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                                                                <Button Command="{Binding Apply}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,0,6" HorizontalContentAlignment="Stretch">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                                                            <TextBlock Text="{Binding Speed}" Style="{StaticResource Muted}" HorizontalAlignment="Left"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                            <TextBlock Text="{Binding Timings}" Style="{StaticResource Num}" FontSize="14" HorizontalAlignment="Right"/>
                                                                            <TextBlock Text="{Binding Volt}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- running timings -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding HasCurrent, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Command="{Binding GoCalcCommand}" Style="{StaticResource SecondaryButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8EF;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,1,8,0"/>
                                                <TextBlock Text="{Binding [mem.current.compare], Source={x:Static loc:Loc.Instance}}"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [mem.current], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{Binding CurrentHeader}" Foreground="{StaticResource Text2Brush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding CurrentTimings}" Margin="0,16,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="10,7" Margin="0,0,16,0">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Num}"/>
                                                        <TextBlock Text="{Binding Key}" Foreground="{StaticResource Text2Brush}" FontSize="13"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ======================= page: stability test ======================= -->
                <Grid Visibility="{Binding IsTestPage, Converter={StaticResource Vis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Style="{StaticResource PageHeader}">
                        <TextBlock Text="{Binding [page.test.title], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{Binding [page.test.sub], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource PageSub}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,0,28,24">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1480"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <!-- memory latency: one quick number to compare timings before/after -->
                            <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,2,24,0">
                                        <TextBlock Text="{Binding [lat.title], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" FontSize="16"/>
                                        <TextBlock Text="{Binding [lat.how], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20" FontSize="13" MaxWidth="720" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding LatencyStatus}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="{Binding LatencyStatus, Converter={StaticResource NullCollapsed}}"/>
                                        <ItemsControl ItemsSource="{Binding LatencyOlder}" Margin="0,14,0,0" Focusable="False" Visibility="{Binding HasOlderLatency, Converter={StaticResource Vis}}" HorizontalAlignment="Left">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:LatencyRowViewModel}">
                                                    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="4,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="230"/>
                                                                <ColumnDefinition Width="Auto" MinWidth="150"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding When}" Style="{StaticResource Num}" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Left"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Num}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Setup}" FontSize="13" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Delta}" FontSize="13" Foreground="{Binding DeltaBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding [lat.note], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="720" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                        <Button Command="{Binding MeasureLatencyCommand}" Style="{StaticResource PrimaryButton}" MinWidth="190" Padding="22,11">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,1,10,0"/>
                                                <TextBlock Text="{Binding [lat.run], Source={x:Static loc:Loc.Instance}}"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{Binding LatencyLast.Value}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,14,2,0"
                                                   Typography.NumeralAlignment="Tabular" Visibility="{Binding HasLatency, Converter={StaticResource Vis}}"/>
                                        <TextBlock Text="{Binding LatencyLast.FullRandom}" Foreground="{StaticResource Text2Brush}" FontSize="12.5" HorizontalAlignment="Right" Margin="0,0,2,2"
                                                   Visibility="{Binding LatencyLast.FullRandom, Converter={StaticResource NullCollapsed}}"/>
                                        <TextBlock Text="{Binding LatencyLast.Setup}" Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,0,2,2"
                                                   Visibility="{Binding LatencyLast.Setup, Converter={StaticResource NullCollapsed}}"/>
                                        <TextBlock Text="{Binding LatencyLast.Delta}" Foreground="{Binding LatencyLast.DeltaBrush}" FontSize="12.5" HorizontalAlignment="Right" Margin="0,0,2,0"
                                                   Visibility="{Binding LatencyLast.Delta, Converter={StaticResource NullCollapsed}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="24,22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,2,0,0">
                                        <TextBlock Text="TestMem5" Style="{StaticResource CardTitle}" FontSize="16"/>
                                        <TextBlock Text="{Binding [tm5.how], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20" FontSize="13" MaxWidth="720" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding [tm5.config], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox ItemsSource="{Binding Tm5Configs}" SelectedItem="{Binding SelectedTm5Config}" Width="280" AutomationProperties.Name="{Binding [tm5.config], Source={x:Static loc:Loc.Instance}}"/>
                                            <Button Command="{Binding StartTm5Command}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" MinWidth="190">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,1,10,0"/>
                                                    <TextBlock Text="{Binding [tm5.start], Source={x:Static loc:Loc.Instance}}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding OpenTm5FolderCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,1,8,0"/>
                                                    <TextBlock Text="{Binding [tm5.folder], Source={x:Static loc:Loc.Instance}}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Tm5Status}" Foreground="{StaticResource Text2Brush}" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding Tm5Status, Converter={StaticResource NullCollapsed}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- last result -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" DataContext="{Binding Tm5Last}"
                                    Visibility="{Binding DataContext.HasTm5, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="26" Background="{Binding Tint}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                        <TextBlock Text="{Binding [tm5.last], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource Text2Brush}" FontSize="13"/>
                                        <TextBlock Text="{Binding Result}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding Brush}" Margin="0,2,0,0"/>
                                        <TextBlock Foreground="{StaticResource Text2Brush}" FontSize="13" Margin="0,4,0,0">
                                            <Run Text="{Binding Config, Mode=OneWay}"/><Run Text="     "/><Run Text="{Binding Duration, Mode=OneWay}"/><Run Text="     "/><Run Text="{Binding Size, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" Margin="0,2,0,0" Visibility="{Binding Source, Converter={StaticResource NullCollapsed}}"/>
                                        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorBrush}" FontSize="12.5" Margin="0,8,0,0" Visibility="{Binding HasErrors, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- history -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Command="{Binding AddTm5FolderCommand}" Style="{StaticResource QuietButton}" VerticalAlignment="Top" Margin="12,-6,-10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,1,8,0"/>
                                                <TextBlock Text="{Binding [tm5.addfolder], Source={x:Static loc:Loc.Instance}}"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [tm5.history], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{Binding Tm5SourcesText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasTm5Sources, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding [tm5.none], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Muted}" FontSize="13" Visibility="{Binding HasTm5, Converter={StaticResource NotVis}}"/>
                                    <ItemsControl ItemsSource="{Binding Tm5History}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:Tm5SessionViewModel}">
                                                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="4,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="200"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" Foreground="{Binding Brush}" FontSize="14" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding When}" Style="{StaticResource Num}" Foreground="{StaticResource Text2Brush}"/>
                                                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Config}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                                            <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Visibility="{Binding Source, Converter={StaticResource NullCollapsed}}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding Duration}" Style="{StaticResource Num}" Foreground="{StaticResource Text2Brush}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Result}" Foreground="{Binding Brush}" FontSize="13" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ======================= page: settings ======================= -->
                <Grid Visibility="{Binding IsSettingsPage, Converter={StaticResource Vis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Style="{StaticResource PageHeader}">
                        <TextBlock Text="{Binding [page.settings.title], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{Binding [page.settings.sub], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource PageSub}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,0,28,24">
                        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="120"
                                             AutomationProperties.Name="Idioma / Language"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xF2B7;" FontFamily="{StaticResource Icons}" FontSize="18" Margin="0,2,14,0"/>
                                        <TextBlock Text="{Binding [set.language], Source={x:Static loc:Loc.Instance}}" FontSize="14"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding [set.components], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding [set.cpu], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CpuText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Text="{Binding [nav.memory], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MemoryText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Text="{Binding [set.driver], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DriverText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Text="{Binding [set.rights], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AdminText}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding [set.credits], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding [set.credits.body], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" LineHeight="20" FontSize="13"/>
                                    <TextBlock Text="Zeyh DRAM Tweaker 1.3" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
